# ======================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - SOBRESCREVE VALORES DO docker/.env
# ======================================================================
# Copie para docker/.env-local e preencha os valores reais.
# docker/.env-local está no .gitignore e NUNCA deve ser commitado.

# ======== VERSÃO DO SUPERSET ========
# Pinada. TAG (imagem oficial) e BROWSER_TAG (nossa imagem com Chromium) andam
# juntos. Para subir de versão: docs em README.md > "Upgrade de versão".
TAG=6.1.0
BROWSER_TAG=6.1.0

# Modo de desenvolvimento DESLIGADO
DEV_MODE=false
SUPERSET_BUILD_TARGET=lean

# Ambiente e debug
SUPERSET_ENV=production
FLASK_ENV=production
FLASK_DEBUG=false
SUPERSET_LOG_LEVEL=info

# Sem exemplos em produção
SUPERSET_LOAD_EXAMPLES=no

# ATENÇÃO: esta variável é build-arg do Dockerfile OFICIAL do Superset e não
# tem efeito neste setup — aqui o browser vem pronto na imagem própria
# docker-browser/Dockerfile. Mantida só para não divergir do .env do upstream.
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=false
CYPRESS_CONFIG=false

# ======== SECRET KEY (CRÍTICO!) ========
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=<GERAR-UMA-CHAVE-UNICA>

# ======== HOSTS ========
SUPERSET_WEBSERVER_DOMAINS=<IP-DO-SERVIDOR>,<SEU-DOMINIO>
GLOBAL_ASYNC_QUERIES_WEBSOCKET_URL=ws://<SEU-DOMINIO>:8080/

# ======== WEBDRIVER (Alerts & Reports) ========
# TEM que ser a URL INTERNA da rede docker. Se apontar para o domínio público,
# o worker sai pela internet, volta pelo nginx e passa a validar TLS — aí todo
# alerta quebra junto com o certificado (SSL: CERTIFICATE_VERIFY_FAILED),
# inclusive os que nem tiram print. O link público do e-mail é outro setting
# (WEBDRIVER_BASEURL_USER_FRIENDLY, em superset_config_docker.py).
SUPERSET_WEBDRIVER_BASEURL=http://superset:8088/
SQLALCHEMY_TRACK_MODIFICATIONS=false

# ======== EMAIL / SMTP ========
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=apikey
MAIL_PASSWORD=<API-KEY-DO-SENDGRID>
MAIL_DEFAULT_SENDER=<remetente@seu-dominio>

ALERT_REPORTS=true

# ======== COCKPIT (DEV-1821) ========
# Token da origem `superset` no Cockpit (SSM /cockpit/EVENTOS_TOKEN_SUPERSET).
# O destinatário Webhook https://cockpit.astecha.com.br/api/interno/eventos/superset
# manda o alerta para o Cockpit abrir o ticket; sem token o envio é recusado.
COCKPIT_EVENTOS_TOKEN=<TOKEN-DA-ORIGEM-SUPERSET>
